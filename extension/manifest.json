{
  "manifest_version": 3,
  "name": "Light Table for Google Photos",
  "short_name": "Light Table",
  "version": "0.7.0",
  "description": "Pick Google Photos by date or album, filter by type, group bursts, manage albums, trash, zoom and download originals.",
  "homepage_url": "https://github.com/mangelino/light-table-for-google-photos",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Light Table",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
